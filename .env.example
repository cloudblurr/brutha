# xAI API key — get one at https://console.x.ai
# Copy this file to .env.local and paste your key. NEVER commit .env.local.
XAI_API_KEY=*** Optional: override the Grok model (defaults to grok-3)
# XAI_MODEL=grok-3

# --- Agent tuning (optional) ---
# Behavior knobs for the agent (no model weight training involved).
# AGENT_TEMPERATURE=0.2     # sampling temperature; lower = more deterministic tool use
# AGENT_MAX_STEPS=14        # max model<->tool steps before the loop stops

# --- Temporal durable execution (optional) ---
# When TEMPORAL_API_KEY or TEMPORAL_ADDRESS is set, the chat API runs the agent
# as a durable Temporal workflow (survives restarts, retries transient errors).
# Start the worker with: npm run worker
#
# TEMPORAL_ADDRESS=brutha.m7tl8.tmprl.cloud:7233
# TEMPORAL_NAMESPACE=brutha.m7tl8
# TEMPORAL_TASK_QUEUE=brutha-agent
# TEMPORAL_API_KEY=   # SECRET — Temporal Cloud API key (JWT). Put in .env.local ONLY. Never commit.
#
# Force durable mode on/off explicitly (overrides auto-detection):
# AGENT_DURABLE=1     # 1 = always durable, 0 = always streaming
# For a LOCAL Temporal dev server (no TLS/key), set AGENT_DURABLE=1 and leave
# TEMPORAL_API_KEY unset (defaults to localhost:7233 / "default").

# --- Email (optional) ---
# Required only if you want the sendEmail tool to work.
# For Gmail: host=smtp.gmail.com, port=465, user=you@gmail.com,
# pass=an APP PASSWORD (https://myaccount.google.com/apppasswords), not your login password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Your Name <you@example.com>"

# Default recipient for sendEmail when called without a 'to' address.
# TEST_EMAIL_TO=you@example.com
