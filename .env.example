# ── Required ────────────────────────────────────────────────────────────────
# xAI API key — the agent cannot run without this.
XAI_API_KEY=

# ── Model / agent tuning (optional) ─────────────────────────────────────────
# XAI_MODEL=grok-3
# AGENT_TEMPERATURE=0.2
# AGENT_MAX_STEPS=14

# ── Authentication (optional — Auth.js) ─────────────────────────────────────
# The app runs with ZERO auth config: a dev credentials login auto-creates an
# account on first sign-in (development only). For production, set AUTH_SECRET
# and configure at least one provider below.
#
# Generate a secret with:  openssl rand -base64 32
# AUTH_SECRET=
#
# GitHub OAuth (https://github.com/settings/developers)
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
#
# Google OAuth (https://console.cloud.google.com/apis/credentials)
#   Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
#
# Force the email/password dev login on (1) or off (0). Defaults: on in
# development, off in production.
# AUTH_ALLOW_DEV_LOGIN=0

# ── Email / SMTP (optional) ─────────────────────────────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=BRUTHA <you@example.com>
# TEST_EMAIL_TO=

# -- Model provider (optional; default = xai) --------------------------------
# Route through any OpenAI-compatible endpoint without code changes.
# AGENT_PROVIDER=openai-compatible
# AGENT_BASE_URL=https://your-gateway.example.com/v1
# AGENT_API_KEY=
# AGENT_MODEL=
# AGENT_STEP_WARN=

# -- Persona overlay (optional; default = general) ---------------------------
# One of: general | legal | finance | ops
# AGENT_PERSONA=general

# -- Admin gate for /admin/tools and /api/tools (optional) -------------------
# When set, callers must pass it via the x-admin-secret header or ?admin_key=.
# ADMIN_SECRET=

# ── Temporal durable execution (optional) ───────────────────────────────────
# Enables durable agent + worker runs that survive restarts and get retries.
# Set AGENT_DURABLE=1 to use a local dev server (localhost:7233), or point at
# Temporal Cloud with an address + API key.
# AGENT_DURABLE=0
# TEMPORAL_ADDRESS=
# TEMPORAL_NAMESPACE=
# TEMPORAL_API_KEY=
# TEMPORAL_TASK_QUEUE=brutha-agent
