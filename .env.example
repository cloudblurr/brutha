# ── Required ────────────────────────────────────────────────────────────────
# Puter.js account auth token — the agent's Grok inference runs through Puter.
# Get it from https://puter.com/dashboard#account (Auth Token → Copy).
# Treat it like a password; all model usage bills to that Puter account.
PUTER_AUTH_TOKEN=

# Supabase project connection (public values, safe to expose to the browser).
# Find these in your Supabase dashboard → Project Settings → API, or run
# `supabase start` locally and copy the printed values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key (SERVER ONLY — never expose to the browser).
# Used by the admin client and the run-worker Edge Function. Project Settings →
# API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# ── Model / agent tuning (optional) ─────────────────────────────────────────
# Grok model id served by Puter (default: x-ai/grok-4-1-fast). Other options:
# x-ai/grok-4.3, x-ai/grok-4.20, x-ai/grok-code-fast-1, ...
# XAI_MODEL=x-ai/grok-4-1-fast
# AGENT_TEMPERATURE=0.2
# AGENT_MAX_STEPS=14

# ── Image generation (optional) ─────────────────────────────────────────────
# The generateImage tool (feature-flagged off by default) calls xAI directly.
# Leave XAI_API_KEY unset unless you want image generation.
# XAI_API_KEY=
# XAI_IMAGE_MODEL=grok-imagine-image

# ── Authentication (optional) ───────────────────────────────────────────────
# Auth is handled by Supabase Auth. Email/password works out of the box.
# To show OAuth buttons in the UI, list the providers you've enabled in the
# Supabase dashboard (Authentication → Providers). Comma-separated.
# NEXT_PUBLIC_AUTH_PROVIDERS=github,google
#
# Configure the provider client IDs/secrets in the Supabase dashboard (hosted)
# or via supabase/config.toml + env (local):
#   SUPABASE_AUTH_GITHUB_CLIENT_ID / SUPABASE_AUTH_GITHUB_SECRET
#   SUPABASE_AUTH_GOOGLE_CLIENT_ID / SUPABASE_AUTH_GOOGLE_SECRET

# ── Email / SMTP (optional) ─────────────────────────────────────────────────
# nodemailer works on Vercel serverless. Leave unset to disable the sendEmail
# tool (it reports "not configured" instead of failing).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=BRUTHA <you@example.com>
# TEST_EMAIL_TO=

# ── Edge Function (run-worker) — set as Supabase secrets, not here ──────────
# These are configured with `supabase secrets set` (or the dashboard), NOT in
# this Next.js env file. The function also receives SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY automatically.
#   supabase secrets set XAI_API_KEY=...  XAI_MODEL=grok-3  AGENT_MAX_STEPS=14
#
# For the DB trigger that dispatches the function, set (once, in SQL):
#   alter database postgres set "app.settings.edge_url"        = 'https://<ref>.supabase.co';
#   alter database postgres set "app.settings.service_role_key" = '<service-role-key>';
# On hosted Supabase you can instead wire this via Database Webhooks in the UI.
